import face_recognition
import numpy as np
import json
import os
import cv2
from app.utils.liveness import check_liveness

KNOWN_FACES_DIR = "known_faces"

def register_face(image_path: str, roll_number: str) -> str:
    """
    Register a student's face
    Returns face encoding as JSON string
    """
    image = face_recognition.load_image_file(image_path)
    encodings = face_recognition.face_encodings(image)
    
    if not encodings:
        return None
    
    encoding = encodings[0]
    
    # Save face image to known_faces folder
    img = cv2.imread(image_path)
    cv2.imwrite(f"{KNOWN_FACES_DIR}/{roll_number}.jpg", img)
    
    # Return encoding as JSON string for database storage
    return json.dumps(encoding.tolist())

def recognize_face(frame, check_live: bool = True) -> dict:
    """
    Recognize a face from camera frame
    Returns student roll number or unknown
    """
    # Step 1 — Check liveness first
    if check_live:
        liveness = check_liveness(frame)
        if not liveness["is_live"]:
            return {
                "recognized": False,
                "roll_number": None,
                "reason": "Liveness check failed — possible photo spoofing",
                "confidence": 0.0
            }
    
    # Step 2 — Load all known faces
    known_encodings = []
    known_rolls = []
    
    if not os.path.exists(KNOWN_FACES_DIR):
        os.makedirs(KNOWN_FACES_DIR)
    
    for filename in os.listdir(KNOWN_FACES_DIR):
        if filename.endswith(".jpg") or filename.endswith(".png"):
            roll = filename.split(".")[0]
            img = face_recognition.load_image_file(f"{KNOWN_FACES_DIR}/{filename}")
            encodings = face_recognition.face_encodings(img)
            if encodings:
                known_encodings.append(encodings[0])
                known_rolls.append(roll)
    
    if not known_encodings:
        return {
            "recognized": False,
            "roll_number": None,
            "reason": "No registered students found",
            "confidence": 0.0
        }
    
    # Step 3 — Recognize face in frame
    rgb_frame = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    face_locations = face_recognition.face_locations(rgb_frame)
    face_encodings = face_recognition.face_encodings(rgb_frame, face_locations)
    
    if not face_encodings:
        return {
            "recognized": False,
            "roll_number": None,
            "reason": "No face detected in frame",
            "confidence": 0.0
        }
    
    # Step 4 — Compare with known faces
    for face_encoding in face_encodings:
        distances = face_recognition.face_distance(known_encodings, face_encoding)
        best_match_idx = np.argmin(distances)
        confidence = 1 - distances[best_match_idx]
        
        if confidence > 0.6:  # 60% confidence threshold
            return {
                "recognized": True,
                "roll_number": known_rolls[best_match_idx],
                "reason": "Face recognized successfully",
                "confidence": round(float(confidence), 2)
            }
    
    return {
        "recognized": False,
        "roll_number": None,
        "reason": "Face not recognized",
        "confidence": 0.0
    }